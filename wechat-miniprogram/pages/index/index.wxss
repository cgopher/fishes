/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.welcome-message {
  background-color: #ffffcc;
  border: 2rpx solid #cccc99;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.title-section {
  text-align: center;
  margin: 30rpx 0;
}

.main-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

/* 绘画工具栏 */
.paint-toolbar {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.color-picker {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.color-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.color-btn.active {
  border-color: #4A90E2;
  transform: scale(1.2);
  box-shadow: 0 0 10rpx rgba(74, 144, 226, 0.5);
}

.tool-buttons {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  flex: 1;
  padding: 16rpx 0;
  background-color: #F0F0F0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  border: none;
}

.tool-btn::after {
  border: none;
}

.size-slider {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.size-label {
  font-size: 28rpx;
  color: #666;
  white-space: nowrap;
}

/* 画布容器 */
.canvas-container {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: background-color 0.3s;
}

.canvas-container.fish-valid {
  background-color: #eaffea;
}

.canvas-container.fish-invalid {
  background-color: #ffeaea;
}

.draw-canvas {
  width: 100%;
  height: 400rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background-color: white;
}

.fish-probability {
  text-align: center;
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: center;
  margin: 30rpx 0;
}

.swim-btn {
  width: 80%;
  padding: 30rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.4);
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background-color: white;
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  text-align: center;
}

.loading-content text {
  font-size: 28rpx;
  color: #333;
}
