/* pages/index/index.wxss */
.draw-container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

/* 欢迎消息 */
.welcome-message {
  background: #ffffcc;
  border: 2rpx solid #cccc99;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.main-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 绘画工具栏 */
.paint-toolbar {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.color-picker {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.color-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.color-btn.active {
  border-color: #4A90E2;
  transform: scale(1.2);
  box-shadow: 0 4rpx 8rpx rgba(74, 144, 226, 0.4);
}

.tool-buttons {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tool-btn {
  padding: 15rpx 30rpx;
  font-size: 24rpx;
  background: #F0F0F0;
  border: none;
  border-radius: 8rpx;
  color: #333;
}

.tool-btn::after {
  border: none;
}

.brush-size {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.size-label {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.size-slider {
  flex: 1;
}

.size-value {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: bold;
  min-width: 50rpx;
  text-align: center;
}

/* 画布区域 */
.canvas-wrapper {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: background 0.3s;
}

.canvas-wrapper.valid-fish {
  background: #eaffea;
}

.canvas-wrapper.invalid-fish {
  background: #ffeaea;
}

.draw-canvas {
  width: 100%;
  height: 400rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background: white;
}

.fish-probability {
  text-align: center;
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  flex: 1;
  max-width: 300rpx;
  padding: 25rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.action-btn::after {
  border: none;
}

/* 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog {
  width: 80%;
  max-width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 2rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-body {
  padding: 30rpx;
}

.modal-message {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
  text-align: center;
}

.input-group {
  margin-top: 20rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.artist-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #F0F0F0;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn:first-child {
  border-right: 2rpx solid #F0F0F0;
}
