<!--pages/index/index.wxml-->
<view class="container draw-container">
  <!-- 欢迎消息 -->
  <view class="welcome-message" wx:if="{{showWelcome}}">
    <text>{{welcomeText}}</text>
  </view>

  <!-- 标题区域 -->
  <view class="header">
    <text class="main-title">画条鱼！</text>
    <text class="sub-title">(请让鱼头朝右)</text>
  </view>

  <!-- 绘画工具栏 -->
  <view class="paint-toolbar">
    <!-- 颜色选择 -->
    <view class="color-picker">
      <view 
        class="color-btn {{currentColor === item ? 'active' : ''}}" 
        wx:for="{{colors}}" 
        wx:key="index"
        style="background-color: {{item}}"
        data-color="{{item}}"
        bindtap="selectColor"
      ></view>
    </view>

    <!-- 画笔工具 -->
    <view class="tool-buttons">
      <button class="tool-btn" bindtap="toggleEraser">
        {{isEraser ? '画笔' : '橡皮擦'}}
      </button>
      <button class="tool-btn" bindtap="clearCanvas">清空</button>
      <button class="tool-btn" bindtap="undoCanvas">撤销</button>
      <button class="tool-btn" bindtap="flipCanvas">翻转</button>
    </view>

    <!-- 画笔粗细 -->
    <view class="brush-size">
      <text class="size-label">粗细:</text>
      <slider 
        class="size-slider" 
        min="1" 
        max="20" 
        value="{{lineWidth}}" 
        activeColor="#4A90E2"
        block-size="20"
        bindchange="changeLineWidth"
      />
      <text class="size-value">{{lineWidth}}</text>
    </view>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-wrapper {{canvasBgClass}}">
    <canvas 
      class="draw-canvas" 
      canvas-id="drawCanvas" 
      disable-scroll="true"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
      bindtouchcancel="touchCancel"
    ></canvas>
    
    <!-- 鱼的概率显示 -->
    <view class="fish-probability" wx:if="{{showProbability}}" style="color: {{probabilityColor}}">
      鱼的概率: {{fishProbability}}%
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn btn-secondary" bindtap="goToTank">查看鱼缸</button>
    <button class="action-btn btn-primary" bindtap="submitFish">让它游起来！</button>
  </view>

  <!-- 提交对话框 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title" style="color: {{modalTitleColor}}">{{modalTitle}}</text>
      </view>
      <view class="modal-body">
        <text class="modal-message">{{modalMessage}}</text>
        <view class="input-group">
          <text class="input-label">签名你的作品:</text>
          <input 
            class="artist-input" 
            value="{{artistName}}" 
            placeholder="请输入你的名字"
            bindinput="inputArtistName"
            maxlength="20"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn btn-secondary" bindtap="closeModal">取消</button>
        <button class="modal-btn btn-primary" bindtap="confirmSubmit" disabled="{{submitting}}">
          {{submitting ? '提交中...' : '提交'}}
        </button>
      </view>
    </view>
  </view>
</view>
