/* pages/rank/rank.wxss */
.rank-container {
  padding: 20rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  min-height: 100vh;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 投票卡片 */
.voting-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fish-display {
  width: 100%;
  height: 500rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fish-image {
  width: 100%;
  height: 100%;
}

/* 鱼的信息 */
.fish-meta {
  width: 100%;
  margin-bottom: 30rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 28rpx;
  color: #666;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 投票按钮 */
.vote-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.vote-btn {
  flex: 1;
  padding: 40rpx 20rpx;
  border-radius: 16rpx;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: all 0.3s;
}

.vote-btn::after {
  border: none;
}

.vote-btn:active:not([disabled]) {
  transform: scale(0.95);
}

.like-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.dislike-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.vote-icon {
  font-size: 60rpx;
}

.vote-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 跳过按钮 */
.skip-btn {
  width: 100%;
  padding: 25rpx;
  background: #F0F0F0;
  color: #666;
  border-radius: 12rpx;
  border: none;
  font-size: 28rpx;
}

.skip-btn::after {
  border: none;
}

/* 进度指示器 */
.progress-indicator {
  text-align: center;
  margin-top: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 加载卡片 */
.loading-card {
  background: white;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin: 0 20rpx;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #F0F0F0;
  border-top-color: #4A90E2;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 空状态卡片 */
.empty-card {
  background: white;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin: 0 20rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 排行榜按钮 */
.leaderboard-section {
  padding: 20rpx;
  text-align: center;
}

.leaderboard-btn {
  width: 100%;
  max-width: 500rpx;
  padding: 30rpx;
  background: white;
  color: #f5576c;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(255, 255, 255, 0.3);
}

.leaderboard-btn::after {
  border: none;
}

/* 排行榜弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.leaderboard-dialog {
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.leaderboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.leaderboard-title {
  font-size: 36rpx;
  font-weight: bold;
}

.close-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
}

.leaderboard-list {
  flex: 1;
  padding: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 15rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  gap: 20rpx;
}

.rank-number {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  background: #E0E0E0;
  border-radius: 50%;
  flex-shrink: 0;
}

.rank-number.rank-1,
.rank-number.rank-2,
.rank-number.rank-3 {
  background: transparent;
}

.rank-fish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: white;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rank-artist {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-votes {
  font-size: 24rpx;
  color: #E74C3C;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}
