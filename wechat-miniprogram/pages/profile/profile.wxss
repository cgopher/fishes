/* pages/profile/profile.wxss */
.profile-container {
  padding: 20rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.user-header {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: white;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录提示 */
.login-prompt {
  text-align: center;
  padding: 30rpx 0;
}

.prompt-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
  line-height: 1.6;
}

/* 用户统计 */
.user-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能菜单 */
.menu-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #F0F0F0;
  transition: background 0.3s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F5F5F5;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 50rpx;
  color: #CCC;
}

/* 我的鱼列表 */
.my-fish-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.fish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.fish-item {
  width: calc(50% - 10rpx);
  background: #F8F8F8;
  border-radius: 12rpx;
  overflow: hidden;
}

.fish-image {
  width: 100%;
  height: 200rpx;
  background: white;
}

.fish-info {
  padding: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fish-time {
  font-size: 22rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fish-votes {
  font-size: 22rpx;
  color: #E74C3C;
  margin-left: 10rpx;
}

/* 退出登录 */
.logout-section {
  padding: 20rpx;
}

.logout-btn {
  width: 100%;
  padding: 25rpx;
  background: white;
  color: #E74C3C;
  border: 2rpx solid #E74C3C;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.logout-btn::after {
  border: none;
}

/* 关于 */
.about-section {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
}

.about-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.edit-dialog {
  width: 80%;
  max-width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.edit-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 2rpx solid #F0F0F0;
}

.edit-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.edit-body {
  padding: 40rpx 30rpx;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.edit-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.edit-footer {
  display: flex;
  border-top: 2rpx solid #F0F0F0;
}

.edit-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.edit-btn::after {
  border: none;
}

.edit-btn:first-child {
  border-right: 2rpx solid #F0F0F0;
}
