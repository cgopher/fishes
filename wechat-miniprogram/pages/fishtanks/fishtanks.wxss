/* pages/fishtanks/fishtanks.wxss */
.fishtanks-container {
  padding: 20rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  min-height: 100vh;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 登录提示 */
.login-prompt {
  background: white;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin: 40rpx 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.prompt-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.prompt-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 创建按钮区域 */
.create-section {
  padding: 0 20rpx 30rpx;
}

.create-btn {
  width: 100%;
  padding: 40rpx;
  background: white;
  border: 3rpx dashed #4A90E2;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  transition: all 0.3s;
}

.create-btn::after {
  border: none;
}

.create-btn:active {
  transform: scale(0.98);
  background: #F5F5F5;
}

.create-icon {
  font-size: 50rpx;
  color: #4A90E2;
  font-weight: bold;
}

.create-text {
  font-size: 30rpx;
  color: #4A90E2;
  font-weight: bold;
}

/* 鱼缸列表 */
.tanks-list {
  padding: 0 20rpx;
}

.tank-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
}

.tank-card:active {
  transform: scale(0.98);
}

/* 鱼缸预览 */
.tank-preview {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

.fish-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 150rpx;
  align-items: center;
  justify-content: center;
}

.preview-fish {
  width: 100rpx;
  height: 100rpx;
  background: white;
  border-radius: 8rpx;
}

.preview-empty {
  width: 100%;
  text-align: center;
  padding: 40rpx;
}

.empty-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

/* 鱼缸信息 */
.tank-info {
  margin-bottom: 20rpx;
}

.tank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.tank-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.tank-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.tank-badge.public {
  background: #E8F5E9;
  color: #4CAF50;
}

.tank-badge.private {
  background: #FFF3E0;
  color: #FF9800;
}

.tank-description {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.tank-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* 鱼缸操作按钮 */
.tank-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
}

.action-icon-btn {
  flex: 1;
  padding: 15rpx;
  background: #F5F5F5;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.action-icon-btn::after {
  border: none;
}

.action-icon-btn.delete {
  background: #FFEBEE;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: white;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: white;
  font-size: 28rpx;
}

/* 创建弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.create-dialog {
  width: 85%;
  max-width: 650rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.dialog-header {
  padding: 30rpx;
  text-align: center;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
}

.dialog-body {
  padding: 40rpx 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 150rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.dialog-footer {
  display: flex;
  border-top: 2rpx solid #F0F0F0;
}

.dialog-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.dialog-btn::after {
  border: none;
}

.dialog-btn:first-child {
  border-right: 2rpx solid #F0F0F0;
}

/* 详情弹窗 */
.detail-dialog {
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  flex: 1;
}

.close-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
}

.detail-content {
  flex: 1;
  padding: 30rpx;
}

.detail-description {
  padding: 20rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.detail-fish-list {
  margin-top: 20rpx;
}

.fish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.fish-item {
  width: calc(50% - 10rpx);
  background: #F8F8F8;
  border-radius: 12rpx;
  overflow: hidden;
}

.fish-image {
  width: 100%;
  height: 200rpx;
  background: white;
}

.fish-info {
  padding: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fish-artist {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-fish-btn {
  padding: 8rpx 20rpx;
  background: #FFEBEE;
  color: #E74C3C;
  border: none;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.remove-fish-btn::after {
  border: none;
}

.empty-fish {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
  font-size: 26rpx;
  line-height: 1.8;
}
